{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "schiedsrichter-note-web",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "schiedsrichter-note-production",
      "database_id": "25faaf18-f659-48aa-9d50-01ebc38fb931",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "LEGACY_DATA", "id": "cc85a29c39484d0aaee95baf5e0311d3" }
  ],
  "ratelimits": [
    { "name": "LOGIN_RATE_LIMITER", "namespace_id": "2026090301", "simple": { "limit": 10, "period": 60 } }
  ],
  "routes": [
    { "pattern": "schiri.squora.de", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true }
  },
  "env": {
    "development": {
      "name": "schiedsrichter-note-web-development",
      "workers_dev": true,
      "routes": [],
      "d1_databases": [
        { "binding": "DB", "database_name": "schiedsrichter-note-development", "database_id": "1b56a7b7-90ad-4235-bcd8-4f80ef8756fb", "migrations_dir": "migrations" }
      ],
      "kv_namespaces": [
        { "binding": "LEGACY_DATA", "id": "cc85a29c39484d0aaee95baf5e0311d3" }
      ],
      "ratelimits": [
        { "name": "LOGIN_RATE_LIMITER", "namespace_id": "2026090302", "simple": { "limit": 20, "period": 60 } }
      ]
    },
    "staging": {
      "name": "schiedsrichter-note-web-staging",
      "workers_dev": false,
      "d1_databases": [
        { "binding": "DB", "database_name": "schiedsrichter-note-staging", "database_id": "0bc2a1b5-cc28-46a8-8762-aeb446aa01e6", "migrations_dir": "migrations" }
      ],
      "kv_namespaces": [
        { "binding": "LEGACY_DATA", "id": "cc85a29c39484d0aaee95baf5e0311d3" }
      ],
      "ratelimits": [
        { "name": "LOGIN_RATE_LIMITER", "namespace_id": "2026090303", "simple": { "limit": 10, "period": 60 } }
      ],
      "routes": [
        { "pattern": "schiri-staging.squora.de", "custom_domain": true }
      ]
    }
  }
}
