{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "schiedsrichter-note-web",
  "main": "cloudflare/web-router.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "AUTH_EMAIL": "dominik87hahn@gmail.com"
  },
  "secrets": {
    "required": ["AUTH_PASSWORD_HASH", "SESSION_SECRET"]
  },
  "kv_namespaces": [
    {
      "binding": "DATA",
      "id": "cc85a29c39484d0aaee95baf5e0311d3"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "2026083001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "squora.de/schiedsrichter-note*",
      "zone_name": "squora.de"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
