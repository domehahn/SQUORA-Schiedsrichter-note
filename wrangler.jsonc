{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "schiedsrichter-note-web",
  "main": "cloudflare/web-router.ts",
  "compatibility_date": "2026-08-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "squora.de/schiedsrichter-note*",
      "zone_name": "squora.de"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
