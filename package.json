{
  "name": "squora-schiedsrichter-note",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src cloudflare tests",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:worker": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:worker": "npm run build && node tests/worker/prepare.ts && playwright test --config playwright.worker.config.ts",
    "test:service-worker": "npm run build && node scripts/verify-service-worker.mjs",
    "test": "npm run test:unit && npm run test:worker",
    "preview": "vite preview",
    "web:types": "wrangler types --include-runtime false",
    "web:typecheck": "tsc -p cloudflare/tsconfig.json --noEmit",
    "web:dev": "wrangler dev",
    "web:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.1.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@cloudflare/workers-types": "^5.20260830.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxlint": "^1.71.0",
    "typescript": "~5.7.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
